# docker-compose.yml sets these for the container. Copy to .env only to run the gateway on the host with `npm run dev`.
PORT=8080
INSTANCE_ID=local
LLM_REPLICAS=http://localhost:8081
ROUTER_POLICY=prefix_affinity
AFFINITY_MAX_OUTSTANDING=4
MODEL_NAME=qwen2.5-0.5b-instruct
MAX_TOKENS_LIMIT=512
# Abort the upstream call if no token arrives within this many milliseconds.
FIRST_TOKEN_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=120000
NATS_URL=nats://localhost:4222
BATCH_QUEUE_MAX=1000
WORKER_CONCURRENCY=2
GATEWAY_URL=http://localhost:8080
# Set a long random value; anyone holding it can act as any tenant at batch priority.
INTERNAL_TOKEN=change-me-internal-token
MODEL_VERSION=qwen2.5-0.5b-instruct-q4_k_m@9217f5d
EMBED_URL=http://localhost:8082
EXACT_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_THRESHOLD=0.95
REDIS_URL=redis://localhost:6379
RATE_LIMIT_FAIL_OPEN_TIERS=gold,standard
SLOTS_PER_REPLICA=4
MAX_QUEUE=8
MAX_QUEUE_WAIT_MS=5000
CONTEXT_PER_SLOT=2048
DATABASE_URL=postgres://app:app@localhost:5432/llm
DB_POOL_MAX=10
# How long a key lookup is cached in memory: also how long a revoked key keeps working.
AUTH_CACHE_SECONDS=30
