# Copy to .env, or export these, before `npm run dev`. All have working defaults for this stage.
PORT=8080
LLM_URL=http://localhost:8081
MODEL_NAME=qwen2.5-0.5b-instruct
MAX_TOKENS_LIMIT=512
# Abort the upstream call if no token arrives within this many milliseconds.
FIRST_TOKEN_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=120000
