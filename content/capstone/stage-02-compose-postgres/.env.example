# docker-compose.yml sets these for the container. Copy to .env only to run the gateway on the host with `npm run dev`.
PORT=8080
LLM_URL=http://localhost:8081
MODEL_NAME=qwen2.5-0.5b-instruct
MAX_TOKENS_LIMIT=512
# Abort the upstream call if no token arrives within this many milliseconds.
FIRST_TOKEN_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=120000
DATABASE_URL=postgres://app:app@localhost:5432/llm
DB_POOL_MAX=10
# How long a key lookup is cached in memory: also how long a revoked key keeps working.
AUTH_CACHE_SECONDS=30
